filters:
  and:
    - type == "entity"
properties:
  file.name:
    displayName: Page
  category:
    displayName: Category
  last_updated:
    displayName: Last updated
  first_seen:
    displayName: First seen
views:
  - type: table
    name: All entities
    groupBy:
      property: category
      direction: ASC
    order:
      - file.name
      - category
      - last_updated
      - first_seen
