filters:
  and:
    - type == "entity"
    - category == "anti-bot"
properties:
  file.name:
    displayName: Vendor
  last_updated:
    displayName: Last updated
  first_seen:
    displayName: First covered
views:
  - type: table
    name: Anti-bot vendors
    order:
      - file.name
      - last_updated
      - first_seen
