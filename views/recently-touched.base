filters:
  and:
    - last_updated >= date("today") - "90d"
properties:
  file.name:
    displayName: Page
  type:
    displayName: Type
  category:
    displayName: Category
  last_updated:
    displayName: Last updated
views:
  - type: table
    name: Recently touched
    groupBy:
      property: type
      direction: ASC
    order:
      - file.name
      - type
      - category
      - last_updated
